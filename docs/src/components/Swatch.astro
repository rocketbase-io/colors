---
// a single color tile — the text color is the one the library itself would pick
// via isBlackContrastingColor(), so the tile is a live demo of that method
interface Props {
	name: string;
	hex: string;
	black: boolean;
	oklch?: string;
	compact?: boolean;
}

const { name, hex, black, oklch, compact = false } = Astro.props;
---

<div
	class:list={['swatch', { compact }]}
	style={`--bg: #${hex}; --fg: ${black ? '#000' : '#fff'}`}
	title={`${name} · #${hex}`}
>
	<span class="name">{name}</span>
	<span class="hex">#{hex}</span>
	{oklch && <span class="oklch">{oklch}</span>}
</div>

<style>
	.swatch {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.55rem 0.6rem;
		min-height: 5.25rem;
		border-radius: 0.375rem;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}
	.swatch.compact {
		min-height: 3.75rem;
	}
	.name {
		font-weight: 600;
	}
	.hex,
	.oklch {
		opacity: 0.82;
		font-size: 0.66rem;
	}
	.oklch {
		margin-top: auto;
	}
</style>
